{
  "name": "web-terrarium",
  "version": "0.1.0",
  "description": "Package a Node.js web app (Next.js, Vite, Express) and its local servers, such as a mock backend, as a Windows or Mac desktop app (Electron).",
  "private": true,
  "license": "MIT",
  "author": "Steve Zhang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevez/web-terrarium.git"
  },
  "homepage": "https://github.com/stevez/web-terrarium#readme",
  "bugs": {
    "url": "https://github.com/stevez/web-terrarium/issues"
  },
  "keywords": [
    "electron",
    "desktop",
    "nextjs",
    "vite",
    "nodejs",
    "offline",
    "demo",
    "mock-server"
  ],
  "type": "module",
  "bin": {
    "web-terrarium": "bin/web-terrarium.mjs",
    "next-desktop": "bin/web-terrarium.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "!src/**/__tests__"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "electron": ">=33",
    "electron-builder": ">=26",
    "esbuild": ">=0.24",
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    }
  }
}
